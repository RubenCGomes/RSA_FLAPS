# .env.jetson.example
# Copy to .env on each Jetson and fill in the values for that node.
#
# Jetson 1 (aggregator) needs: AGGREGATOR_IP, CLIENT_1_IP
# Jetson 2 (client 1)   needs: AGGREGATOR_IP, CLIENT_ID, TARGET_STEM, DATASET_PATH
# Jetson 3 (client 2)   needs: AGGREGATOR_IP, CLIENT_ID, TARGET_STEM, DATASET_PATH

# ---------------------------------------------------------------------------
# Network — 802.11s mesh IPs
# ---------------------------------------------------------------------------
AGGREGATOR_IP=192.168.100.3     # Jetson 638
CLIENT_1_IP=192.168.100.2       # Jetson 681 <----
CLIENT_2_IP=192.168.100.1       # Jetson 688

# ---------------------------------------------------------------------------
# Node identity  (set per-node before running docker compose)
# ---------------------------------------------------------------------------
CLIENT_ID=0                     # 0 for Jetson 681, 1 for Jetson 688
TARGET_STEM=vocals              # vocals (Jetson 681) | drums (Jetson 688)

# ---------------------------------------------------------------------------
# Paths  (absolute paths on this Jetson)
# ---------------------------------------------------------------------------
DATASET_PATH=/home/nap/rsa-project/MobFedLS/assets/datasets/musdb18hq
LOGS_PATH=/home/nap/rsa-project/MobFedLS/assets/logs/flaps

# ---------------------------------------------------------------------------
# FL hyperparameters  (set on aggregator; clients inherit from server config)
# ---------------------------------------------------------------------------
N_CLIENTS=2
N_ROUNDS=5
N_EPOCHS=2
BATCH_SIZE=1
FL_ALGORITHM=FedAvg
ROUND_TIMEOUT=0

# ---------------------------------------------------------------------------
# ML / audio settings
# ---------------------------------------------------------------------------
MODEL_NAME=unet_small
BASE_FILTERS=8
SAMPLE_RATE=8000
SEGMENT_SECONDS=2.0
N_FFT=512
HOP_LENGTH=128
TRAIN_CHUNK_DURATION=2.0
MAX_TRAIN_SEGMENTS=50
MAX_EVAL_SEGMENTS=10
USE_AMP=true                    # enable mixed precision (Jetson GPU)
AUGMENT_TRAIN=true
AUGMENT_STEM_DROPOUT_PROB=0.3   # probability of zeroing a stem (makes cls task non-trivial)
LOSS_CLS_WEIGHT=0.1             # weight of classification loss on top of separation loss
LOGGING_LEVEL=INFO